<Window x:Class="BoostFPS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoostFPS" Height="820" Width="1240"
        Icon="Assets/logo.png"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgElevated}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/logo.png" Width="34" Height="34"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="BoostFPS" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Subtle}"
                               Text="Windows FPS / input-lag optimizer" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,16">
                    <TextBlock x:Name="MachineText" Style="{StaticResource Subtle}" />
                </StackPanel>

                <StackPanel x:Name="NavPanel">
                    <RadioButton Style="{StaticResource NavButton}" Content="Dashboard" Tag="Dashboard" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Registry tweaks" Tag="Tweaks" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Services" Tag="Services" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="NVIDIA (.nip)" Tag="Nvidia" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Group Policy" Tag="Gpo" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Network / Power" Tag="NetworkPower" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="RAM Cleaner" Tag="Cleaner" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="DNS Optimizer" Tag="Dns" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Games / Game Mode" Tag="Games" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Baseline Diff" Tag="Baseline" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Backup / Revert" Tag="Backup" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Log" Tag="Log" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- content -->
        <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
               Background="Transparent" />
    </Grid>
</Window>
