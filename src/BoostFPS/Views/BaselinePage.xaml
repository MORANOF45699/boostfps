<Page x:Class="BoostFPS.Views.BaselinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}" Title="Baseline Diff">

    <DockPanel Margin="28,24,28,20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Baseline Diff" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                       Text="เทียบค่า registry ปัจจุบันกับ Windows default ของทุก tweak ที่ใช้ได้บนเครื่องนี้ ไม่ต้องลง Windows ใหม่ก็เห็นเลยว่าอะไรถูก tune ไปแล้ว" />

            <WrapPanel Margin="0,14,0,0">
                <CheckBox x:Name="DiffOnly" Content="แสดงเฉพาะที่ต่างจาก default" IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,20,8" />
                <Button Content="รีเฟรช" Click="Refresh_Click" Margin="0,0,8,8" />
                <Button Content="Export CSV" Click="Export_Click" Margin="0,0,8,8" />
            </WrapPanel>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12,10">
                <TextBlock x:Name="SummaryText" Style="{StaticResource Subtle}" />
            </Border>
        </StackPanel>

        <DataGrid x:Name="DiffGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{StaticResource BgCard}" Foreground="{StaticResource Text}"
                  RowBackground="{StaticResource BgCard}" AlternatingRowBackground="{StaticResource BgElevated}"
                  BorderBrush="{StaticResource Border}" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource Border}" HeadersVisibility="Column"
                  CanUserResizeColumns="True" CanUserSortColumns="True" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" />
                <DataGridTextColumn Header="Tweak" Binding="{Binding TweakName}" Width="240" />
                <DataGridTextColumn Header="Value" Binding="{Binding ValueName}" Width="180" />
                <DataGridTextColumn Header="ตอนนี้" Binding="{Binding CurrentDisplay}" Width="130" />
                <DataGridTextColumn Header="Default (Win)" Binding="{Binding DefaultDisplay}" Width="130" />
                <DataGridTextColumn Header="ถ้าเปิด tweak" Binding="{Binding OnDisplay}" Width="130" />
                <DataGridTextColumn Header="สถานะ" Binding="{Binding StateText}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>
