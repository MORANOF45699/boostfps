<Page x:Class="BoostFPS.Views.GroupPolicyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}" Title="Group Policy">

    <DockPanel Margin="28,24,28,20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Group Policy" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                       Text="ตัวเดียวกับที่อยู่ใน gpedit.msc (Local Group Policy Editor) เขียนตรงเข้า HKLM\SOFTWARE\Policies\* — Home edition ไม่มี gpedit แต่แก้ policy key ตรง ๆ ได้ผลเหมือนกัน ทุกอันช่วยเรื่อง FPS/ตอบสนอง 3 ทาง: คืน bandwidth, ลดโปรเซสเบื้องหลัง, กันการรบกวนระหว่างเล่น" />

            <WrapPanel Margin="0,14,0,0">
                <Button x:Name="ApplyAll" Style="{StaticResource PrimaryButton}"
                        Content="เปิดทั้งหมด" Click="ApplyAll_Click" Margin="0,0,8,8" />
                <Button Style="{StaticResource DangerButton}" Content="ปิดทั้งหมด (revert)"
                        Click="RevertAll_Click" Margin="0,0,8,8" />
                <Button Content="รีเฟรช" Click="Refresh_Click" Margin="0,0,8,8" />
            </WrapPanel>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12,10">
                <TextBlock x:Name="SummaryText" Style="{StaticResource Subtle}" />
            </Border>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PolicyList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsOn, Mode=OneWay}"
                                          Click="Toggle_Click" Tag="{Binding}"
                                          VerticalAlignment="Top" Margin="0,2,12,0" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Subtle}"
                                               FontSize="11" Opacity="0.75" Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding RiskText}" Foreground="{Binding RiskBrush}"
                                               FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
