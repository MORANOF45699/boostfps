<Page x:Class="BoostFPS.Views.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}" Title="Games">

    <DockPanel Margin="28,24,28,20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Games / Game Mode" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                       Text="รวมเกมจากสามที่: process ที่เปิดอยู่, Windows Game Mode และ Windows Graphics settings (Custom settings for applications) จัดการทีเดียวจากตรงนี้" />

            <WrapPanel Margin="0,12,0,0">
                <Button Content="รีเฟรชรายการ" Click="Refresh_Click" Margin="0,0,8,8" />
                <Button Content="เพิ่มไฟล์ .exe เอง..." Click="AddManual_Click" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GameList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock FontSize="14" FontWeight="SemiBold">
                                        <Run Text="{Binding ExeName, Mode=OneWay}" />
                                        <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusBrush}" FontSize="11" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding ExePath}" Style="{StaticResource Subtle}" FontSize="11" Opacity="0.7" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                                    <Button Content="Boost live" Click="Boost_Click" Tag="{Binding}"
                                            Margin="0,0,6,0" Visibility="{Binding BoostVisibility}" />
                                    <Button Content="เพิ่มลง Game Mode" Style="{StaticResource PrimaryButton}"
                                            Click="AddGameMode_Click" Tag="{Binding}" Margin="0,0,6,0"
                                            Visibility="{Binding AddGmVisibility}" />
                                    <Button Content="เอาออกจาก Game Mode" Style="{StaticResource DangerButton}"
                                            Click="RemoveGameMode_Click" Tag="{Binding}" Margin="0,0,6,0"
                                            Visibility="{Binding RemoveGmVisibility}" />
                                    <Button Content="Graphics = High perf" Style="{StaticResource PrimaryButton}"
                                            Click="SetHighPerf_Click" Tag="{Binding}" Margin="0,0,6,0"
                                            Visibility="{Binding AddGpuVisibility}" />
                                    <Button Content="เอาออกจาก Graphics" Style="{StaticResource DangerButton}"
                                            Click="RemoveGpu_Click" Tag="{Binding}"
                                            Visibility="{Binding RemoveGpuVisibility}" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
