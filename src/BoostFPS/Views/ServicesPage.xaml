<Page x:Class="BoostFPS.Views.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}" Title="Services">

    <DockPanel Margin="28,24,28,20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Services" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Subtle}"
                       Text="รายการถูกกรองตามฮาร์ดแวร์จริงของเครื่องนี้แล้ว ตัวที่ระบบยังใช้อยู่จะถูกซ่อนหรือขึ้นเตือน และ service ที่สำคัญต่อการบูตไม่ถูกแสดงเลย" />

            <WrapPanel Margin="0,14,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="ปิดชุด Safe ทั้งหมด"
                        Click="DisableTier_Click" Tag="Safe" Margin="0,0,8,8" />
                <Button Content="ปิดชุด Balanced" Click="DisableTier_Click" Tag="Balanced" Margin="0,0,16,8" />
                <Button Content="รีเฟรช" Click="Refresh_Click" Margin="0,0,8,8" />
            </WrapPanel>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12,10">
                <TextBlock x:Name="SummaryText" Style="{StaticResource Subtle}" />
            </Border>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ServiceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsDisabled, Mode=OneWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          Click="Toggle_Click" Tag="{Binding}"
                                          VerticalAlignment="Top" Margin="0,2,12,0" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Impact}" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding GateText}" Foreground="{Binding GateBrush}"
                                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding TierText}" Style="{StaticResource Subtle}"
                                               FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
