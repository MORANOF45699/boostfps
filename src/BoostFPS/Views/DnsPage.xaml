<Page x:Class="BoostFPS.Views.DnsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}" Title="DNS Optimizer">

    <DockPanel Margin="28,24,28,20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="DNS Optimizer" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Subtle}"
                       Text="Ping DNS สาธารณะจากเครื่องนี้ เรียงจากเร็วสุด กด Choose เพื่อตั้งลง adapter ที่เลือก" />

            <Border Style="{StaticResource Card}" Margin="0,14,0,10">
                <StackPanel>
                    <TextBlock Text="Network adapter" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Info}" Margin="0,0,0,8" />
                    <ComboBox x:Name="AdapterCombo" DisplayMemberPath="Label" SelectedValuePath="Alias"
                              MinWidth="360" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CurrentDnsText" Style="{StaticResource Subtle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <WrapPanel>
                <Button x:Name="RankButton" Style="{StaticResource PrimaryButton}"
                        Content="Rank DNS servers" Click="Rank_Click" Margin="0,0,8,8" />
                <Button Content="คืนค่า DHCP" Click="Dhcp_Click" Margin="0,0,8,8" />
                <Button Content="Flush DNS cache" Click="Flush_Click" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock x:Name="UpdatedText" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="14" FontWeight="SemiBold">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding Servers, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Avg. response" Style="{StaticResource Subtle}" FontSize="11" />
                                    <TextBlock Text="{Binding LatencyText}" Foreground="{Binding LatencyBrush}"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>

                                <Button Grid.Column="3" Content="Choose" Click="Choose_Click"
                                        Tag="{Binding}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
