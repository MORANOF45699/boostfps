<Page x:Class="BoostFPS.Views.TweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}" Title="Registry tweaks">

    <DockPanel Margin="28,24,28,20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Registry tweaks" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Subtle}"
                       Text="ทุกครั้งที่กด Apply โปรแกรมจะสร้าง restore point และ backup ค่าเดิมของทุก key ก่อนเขียนเสมอ" />

            <WrapPanel Margin="0,14,0,0">
                <Button x:Name="ApplySafe" Style="{StaticResource PrimaryButton}"
                        Content="เปิดชุด Safe ทั้งหมด" Click="ApplyTier_Click" Tag="Safe" Margin="0,0,8,8" />
                <Button Content="เปิดชุด Balanced" Click="ApplyTier_Click" Tag="Balanced" Margin="0,0,8,8" />
                <Button Content="เปิดชุด Extreme" Click="ApplyTier_Click" Tag="Extreme" Margin="0,0,16,8" />
                <Button Style="{StaticResource DangerButton}" Content="ปิดทั้งหมด (revert)"
                        Click="RevertAll_Click" Margin="0,0,8,8" />
                <Button Content="รีเฟรชสถานะ" Click="Refresh_Click" Margin="0,0,8,8" />
            </WrapPanel>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="12,10">
                <TextBlock x:Name="SummaryText" Style="{StaticResource Subtle}" />
            </Border>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CategoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Info}" Margin="2,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsOn, Mode=OneWay}"
                                                          Click="Toggle_Click" Tag="{Binding}"
                                                          VerticalAlignment="Top" Margin="0,2,12,0" />

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Subtle}"
                                                               FontSize="11" Opacity="0.75" Margin="0,6,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding RiskText}" Foreground="{Binding RiskBrush}"
                                                               FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                                    <Button Content="ดูค่าจริง" FontSize="11" Padding="8,4"
                                                            Margin="0,8,0,0" Click="ShowValues_Click"
                                                            Tag="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
