<Page x:Class="BoostFPS.Views.BackupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg}" Title="Backup / Revert">

    <DockPanel Margin="28,24,28,20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Backup / Revert" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Subtle}"
                       Text="ทุก snapshot เก็บค่าเดิมของเครื่องนี้จริง ๆ ตอนก่อน apply การกู้คืนจึงเขียนค่ากลับตรงตัว ไม่ใช่เดาค่า default" />

            <WrapPanel Margin="0,14,0,0">
                <Button Content="รีเฟรชรายการ" Click="Refresh_Click" Margin="0,0,8,8" />
                <Button Content="เปิดโฟลเดอร์ backup" Click="OpenFolder_Click" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SnapshotList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="14" FontWeight="SemiBold">
                                        <Run Text="{Binding Id, Mode=OneWay}" />
                                        <Run Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0">
                                        <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat=' {0:yyyy-MM-dd HH:mm}'}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0" x:Name="Counts"
                                               Text="{Binding Summary}" />
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource DangerButton}"
                                        Content="กู้คืน snapshot นี้" Click="Restore_Click"
                                        Tag="{Binding Snapshot}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
